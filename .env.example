# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy anon key or the newer publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Either the legacy service_role key or the newer secret key (sb_secret_…). Server-only, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Public base URL used in ticket emails and links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://racik-eventmu.vercel.app

# Secret used to HMAC-sign ticket codes. 32+ random bytes, e.g. `openssl rand -base64 48`.
# Changing it invalidates every issued ticket.
TICKET_SIGNING_SECRET=

# --- Brevo transactional email (leave empty in dev: emails are logged instead) ---
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=tickets@tickets.racikdigital.com
EMAIL_FROM_NAME=Racik EventMu

# --- Cloudflare Turnstile (leave both empty in dev to skip the captcha) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron bearer secret (required in production)
CRON_SECRET=
