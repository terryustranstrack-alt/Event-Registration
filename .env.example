# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in ticket emails and links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to HMAC-sign ticket codes. 32+ random bytes, e.g. `openssl rand -base64 48`.
# Changing it invalidates every issued ticket.
TICKET_SIGNING_SECRET=

# --- Brevo transactional email (leave empty in dev: emails are logged instead) ---
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=tickets@tickets.racikdigital.com
EMAIL_FROM_NAME=Racik Tickets

# --- Cloudflare Turnstile (leave both empty in dev to skip the captcha) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron bearer secret (required in production)
CRON_SECRET=
